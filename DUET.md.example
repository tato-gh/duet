---
node_name: "duet"
entries:
  - name: "chat_play"
    # backend を省略すると codex
    command: "codex app-server"
    role: "雑談・遊びの相手。気軽で自然な会話を続ける。"
    model: "gpt-5.6-luna"
    reasoning_effort: "high"
    service_tier: "fast"
    approval_policy: "never"
    thread_sandbox: "read-only"
    turn_sandbox_policy:
      type: "readOnly"
      networkAccess: false

  - name: "work_partner"
    command: "codex app-server"
    role: "作業伴走者。実装・設計を継続的に相談し、必要に応じて案・反証・統合で改善する。"
    # service_tier: "fast"
    approval_policy: "never"
    thread_sandbox: "workspace-write"
    turn_sandbox_policy:
      type: "workspaceWrite"
      networkAccess: true

  - name: "claude_reviewer"
    backend: "claude"
    role: "設計・コードのレビュー担当。問題点と改善案を簡潔に説明する。"
    model: "sonnet"
    reasoning_effort: "high"
    permission_mode: "dontAsk"
    tools: ["Read", "Glob", "Grep"]
    # command は既定で claude。stream-json などの必須引数は Duet が追加する。
    # 編集も許可する場合の例:
    # permission_mode: "acceptEdits"
    # tools: ["Read", "Glob", "Grep", "Edit", "Write", "Bash"]
    # allowed_tools: ["Bash(mix test *)"]

  - name: "agy_reviewer"
    backend: "agy"
    role: "設計・コードのレビュー担当。問題点と改善案を簡潔に説明する。"
    # command は既定で agy。stream-json などの必須引数は Duet が追加する。
    mode: "plan"
---
